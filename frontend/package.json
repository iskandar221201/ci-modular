{
  "name": "ci4-veu-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix && prettier --write src",
    "format": "prettier --write src",
    "test": "vitest run",
    "test:watch": "vitest",
    "analyze": "ANALYZE=true vite build",
    "prepare": "cd .. && git config core.hooksPath .husky"
  },
  "dependencies": {
    "@unhead/vue": "^1.8.10",
    "axios": "^1.7.2",
    "pinia": "^2.1.7",
    "tus-js-client": "^3.1.0",
    "vue": "^3.4.27",
    "vue-router": "^4.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.4.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.4.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.18.0",
    "flowbite": "^2.5.2",
    "happy-dom": "^14.12.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.7",
    "postcss": "^8.4.38",
    "prettier": "^3.3.2",
    "rollup-plugin-visualizer": "^5.12.0",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1",
